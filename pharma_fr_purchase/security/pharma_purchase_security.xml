<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Le préparateur passe les commandes, le titulaire valide et négocie. -->
    <record id="pharma_fr_base.group_pharma_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="pharma_fr_base.group_pharma_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_manager')), (4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="rule_pharma_purchase_agreement_company" model="ir.rule">
        <field name="name">Conditions commerciales : multi-société</field>
        <field name="model_id" ref="model_pharma_purchase_agreement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
