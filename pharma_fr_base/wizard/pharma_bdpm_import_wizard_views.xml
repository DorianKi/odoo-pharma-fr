<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_bdpm_import_wizard_form" model="ir.ui.view">
        <field name="name">pharma.bdpm.import.wizard.form</field>
        <field name="model">pharma.bdpm.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BDPM">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p>
                        Téléchargez les fichiers sur
                        <a href="https://base-donnees-publique.medicaments.gouv.fr/telechargement" target="_blank">
                            base-donnees-publique.medicaments.gouv.fr</a>
                        (ou lancez <code>scripts/download_bdpm.sh</code>), puis déposez
                        une archive ZIP ou les fichiers un par un. L'import peut être
                        relancé à chaque mise à jour : seules les différences sont écrites.
                    </p>
                    <group>
                        <field name="zip_file" filename="zip_filename"/>
                        <field name="zip_filename" invisible="1"/>
                    </group>
                    <group string="Ou fichiers individuels">
                        <field name="cis_file" filename="cis_filename"/>
                        <field name="cis_filename" invisible="1"/>
                        <field name="cis_cip_file" filename="cis_cip_filename"/>
                        <field name="cis_cip_filename" invisible="1"/>
                        <field name="compo_file" filename="compo_filename"/>
                        <field name="compo_filename" invisible="1"/>
                        <field name="gener_file" filename="gener_filename"/>
                        <field name="gener_filename" invisible="1"/>
                        <field name="cpd_file" filename="cpd_filename"/>
                        <field name="cpd_filename" invisible="1"/>
                        <field name="dispo_file" filename="dispo_filename"/>
                        <field name="dispo_filename" invisible="1"/>
                        <field name="mitm_file" filename="mitm_filename"/>
                        <field name="mitm_filename" invisible="1"/>
                    </group>
                    <group string="Articles officine">
                        <field name="create_products"/>
                        <field name="product_limit" invisible="create_products == 'none'"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <field name="result" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pharma_bdpm_import_wizard" model="ir.actions.act_window">
        <field name="name">Import BDPM</field>
        <field name="res_model">pharma.bdpm.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
