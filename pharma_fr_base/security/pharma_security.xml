<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pharmacy" model="ir.module.category">
        <field name="name">Pharmacie</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_pharmacy" model="res.groups.privilege">
        <field name="name">Pharmacie</field>
        <field name="category_id" ref="module_category_pharmacy"/>
    </record>

    <record id="group_pharma_user" model="res.groups">
        <field name="name">Préparateur / Pharmacien adjoint</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('stock.group_production_lot'))]"/>
    </record>

    <record id="group_pharma_manager" model="res.groups">
        <field name="name">Pharmacien titulaire</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pharmacy"/>
        <field name="implied_ids" eval="[(4, ref('group_pharma_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
