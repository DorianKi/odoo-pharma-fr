<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pharma" model="ir.ui.view">
        <field name="name">res.partner.form.pharma</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_pharma_specialites" type="object" class="oe_stat_button"
                        icon="fa-medkit" invisible="pharma_partner_type != 'laboratory'"
                        groups="pharma_fr_base.group_pharma_user">
                    <field name="pharma_specialite_count" widget="statinfo" string="Spécialités"/>
                </button>
            </div>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="pharma_partner_type" groups="pharma_fr_base.group_pharma_user"/>
            </xpath>
        </field>
    </record>

    <record id="action_pharma_laboratory" model="ir.actions.act_window">
        <field name="name">Laboratoires</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pharma_partner_type', '=', 'laboratory')]</field>
        <field name="context">{'default_pharma_partner_type': 'laboratory', 'default_is_company': True}</field>
    </record>
</odoo>
