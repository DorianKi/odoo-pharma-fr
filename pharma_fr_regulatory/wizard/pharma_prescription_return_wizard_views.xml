<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_prescription_return_wizard_form" model="ir.ui.view">
        <field name="name">pharma.prescription.return.wizard.form</field>
        <field name="model">pharma.prescription.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Retour patient">
                <p class="text-muted">
                    Des avoirs sont émis pour chaque payeur. Les produits retournés sont
                    détruits, sauf s'ils n'ont pas quitté l'officine.
                </p>
                <group>
                    <field name="prescription_id" readonly="1"/>
                    <field name="reason"/>
                    <field name="restock"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Valider le retour" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
