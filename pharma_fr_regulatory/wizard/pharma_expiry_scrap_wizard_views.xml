<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_expiry_scrap_wizard_form" model="ir.ui.view">
        <field name="name">pharma.expiry.scrap.wizard.form</field>
        <field name="model">pharma.expiry.scrap.wizard</field>
        <field name="arch" type="xml">
            <form string="Destruction des périmés">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <group>
                        <field name="limit_date"/>
                    </group>
                    <field name="quant_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="expiration_date"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </div>
                <div invisible="state != 'done'">
                    <field name="result" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_scrap" type="object" string="Détruire" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pharma_expiry_scrap_wizard" model="ir.actions.act_window">
        <field name="name">Destruction des périmés</field>
        <field name="res_model">pharma.expiry.scrap.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
