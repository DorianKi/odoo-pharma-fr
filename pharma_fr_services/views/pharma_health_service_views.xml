<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_health_service_list" model="ir.ui.view">
        <field name="name">pharma.health.service.list</field>
        <field name="model">pharma.health.service</field>
        <field name="arch" type="xml">
            <list string="Missions de santé" decoration-muted="state == 'cancel'">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="date"/>
                <field name="type_id"/>
                <field name="patient_id"/>
                <field name="pharmacist_id" widget="many2one_avatar_user" optional="show"/>
                <field name="duration_minutes" sum="Minutes" optional="hide"/>
                <field name="amount_total" sum="Honoraires"/>
                <field name="amount_amo" sum="AMO" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_pharma_health_service_form" model="ir.ui.view">
        <field name="name">pharma.health.service.form</field>
        <field name="model">pharma.health.service</field>
        <field name="arch" type="xml">
            <form string="Mission de santé">
                <header>
                    <button name="action_done" type="object" string="Réaliser et facturer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="patient_id" readonly="state != 'draft'"/>
                            <field name="pharmacist_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="duration_minutes" readonly="state != 'draft'"/>
                            <field name="amount_total" readonly="state != 'draft'"/>
                            <field name="amount_amo"/>
                            <field name="amount_amc"/>
                            <field name="amount_patient"/>
                            <field name="invoice_ids" widget="many2many_tags" invisible="not invoice_ids"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Observations..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pharma_health_service_search" model="ir.ui.view">
        <field name="name">pharma.health.service.search</field>
        <field name="model">pharma.health.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="type_id"/>
                <field name="pharmacist_id"/>
                <filter name="done" string="Réalisées" domain="[('state', '=', 'done')]"/>
                <filter name="date" string="Date" date="date"/>
                <filter name="group_type" string="Mission" context="{'group_by': 'type_id'}"/>
                <filter name="group_category" string="Catégorie" context="{'group_by': 'category'}"/>
                <filter name="group_pharmacist" string="Pharmacien" context="{'group_by': 'pharmacist_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_pharma_health_service_pivot" model="ir.ui.view">
        <field name="name">pharma.health.service.pivot</field>
        <field name="model">pharma.health.service</field>
        <field name="arch" type="xml">
            <pivot string="Missions de santé">
                <field name="type_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_pharma_health_service" model="ir.actions.act_window">
        <field name="name">Missions de santé</field>
        <field name="res_model">pharma.health.service</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <record id="view_pharma_health_service_type_list" model="ir.ui.view">
        <field name="name">pharma.health.service.type.list</field>
        <field name="model">pharma.health.service.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="category"/>
                <field name="code"/>
                <field name="name"/>
                <field name="amount"/>
                <field name="amo_rate"/>
                <field name="duration_minutes"/>
                <field name="product_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_pharma_health_service_type" model="ir.actions.act_window">
        <field name="name">Types de missions</field>
        <field name="res_model">pharma.health.service.type</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_pharma_health_service" name="Missions de santé"
              parent="pharma_fr_dispensation.menu_pharma_dispensation"
              action="action_pharma_health_service" sequence="15"/>
    <menuitem id="menu_pharma_health_service_type" name="Types de missions"
              parent="pharma_fr_base.menu_pharma_config"
              action="action_pharma_health_service_type" sequence="40"/>
</odoo>
