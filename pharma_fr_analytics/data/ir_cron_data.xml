<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_pharma_stock_snapshot" model="ir.cron">
        <field name="name">Pharmacie : photo quotidienne du stock</field>
        <field name="model_id" ref="model_pharma_stock_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._take_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_pharma_cash_forecast" model="ir.cron">
        <field name="name">Pharmacie : trésorerie prévisionnelle</field>
        <field name="model_id" ref="model_pharma_cash_forecast"/>
        <field name="state">code</field>
        <field name="code">model._compute_forecast()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
