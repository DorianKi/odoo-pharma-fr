<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_fee_rule_list" model="ir.ui.view">
        <field name="name">pharma.fee.rule.list</field>
        <field name="model">pharma.fee.rule</field>
        <field name="arch" type="xml">
            <list string="Honoraires de dispensation" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="amount"/>
                <field name="reimbursement_rate"/>
                <field name="date_from"/>
                <field name="product_id"/>
                <field name="source"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_pharma_fee_rule" model="ir.actions.act_window">
        <field name="name">Honoraires de dispensation</field>
        <field name="res_model">pharma.fee.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Barème daté des honoraires d'ordonnance. L'honoraire à la boîte provient
               de la base des médicaments (BDPM). Ajoutez une ligne à chaque revalorisation.</p>
        </field>
    </record>
</odoo>
