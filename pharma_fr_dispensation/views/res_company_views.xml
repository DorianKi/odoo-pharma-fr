<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pharma" model="ir.ui.view">
        <field name="name">res.company.form.pharma</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pharmacie" name="pharmacy">
                    <group>
                        <field name="pharma_invoicing_mode"/>
                        <field name="pharma_counter_partner_id"
                               invisible="pharma_invoicing_mode != 'daily'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
