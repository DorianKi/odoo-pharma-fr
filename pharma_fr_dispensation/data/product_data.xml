<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_fee_box" model="product.product">
        <field name="name">Honoraire de dispensation à la boîte</field>
        <field name="type">service</field>
        <field name="pharma_is_fee" eval="True"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">1.02</field>
        <field name="default_code">HON-BOITE</field>
    </record>
