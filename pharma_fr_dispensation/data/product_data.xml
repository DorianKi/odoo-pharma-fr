        <field name="pharma_is_fee" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="default_code">HON-AGE</field>
    </record>
    <record id="product_fee_complex" model="product.product">
        <field name="name">Honoraire d'ordonnance complexe</field>
        <field name="type">service</field>
        <field name="pharma_is_fee" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="default_code">HON-COMPLEXE</field>
    </record>
    <record id="product_fee_specific" model="product.product">
        <field name="name">Honoraire de dispensation de médicaments spécifiques</field>
        <field name="type">service</field>
        <field name="pharma_is_fee" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="default_code">HON-SPEC</field>
    </record>
</odoo>
